{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happysecret",
  "account_id": "484a63255f3438b7dec4ffc36c8aadd6",
  "workers_dev": true,
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "SECRETS", "class_name": "Secret" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Secret"] }],
  "ratelimits": [{ "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": false }
}
